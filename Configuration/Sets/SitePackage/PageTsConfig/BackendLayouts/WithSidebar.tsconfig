mod.web_layout.BackendLayouts.with_sidebar {
    title = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.withSidebar
    icon = EXT:your_sitepackage/Resources/Public/Icons/BackendLayouts/with-sidebar.svg

    config.backend_layout {
        colCount = 2
        rowCount = 3

        rows {
            1.columns.1 {
                name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.stage
                colPos = 1
                identifier = stage
                colspan = 2
                slideMode = slide
            }

            2.columns {
                1 {
                    name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.main
                    colPos = 0
                    identifier = main
                }

                2 {
                    name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.sidebar
                    colPos = 2
                    identifier = sidebar
                }
            }

            3.columns.1 {
                name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.footer
                colPos = 3
                identifier = footerContent
                colspan = 2
                slideMode = slide
            }
        }
    }
}
