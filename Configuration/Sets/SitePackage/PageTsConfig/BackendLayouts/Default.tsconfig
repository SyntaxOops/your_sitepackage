mod.web_layout.BackendLayouts.default {
    title = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.default
    icon = EXT:your_sitepackage/Resources/Public/Icons/BackendLayouts/default.svg

    config.backend_layout {
        colCount = 1
        rowCount = 3

        rows {
            1.columns.1 {
                name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.stage
                colPos = 1
                identifier = stage
                slideMode = slide
            }

            2.columns.1 {
                name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.main
                colPos = 0
                identifier = main
            }

            3.columns.1 {
                name = LLL:EXT:your_sitepackage/Resources/Private/Language/locallang.xlf:backendLayout.area.footer
                colPos = 3
                identifier = footerContent
                slideMode = slide
            }
        }
    }
}
